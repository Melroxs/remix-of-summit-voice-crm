# ---------------------------------------------------------------------------
# Lovable Cloud (Supabase) — provided automatically when Cloud is enabled.
# Do not edit .env directly; these values are injected by the platform.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# ---------------------------------------------------------------------------
# Edge function secrets (set via Lovable Cloud → Secrets, never in code)
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=...     # Used by privileged edge functions
# SUPABASE_DB_URL=...               # Used by maintenance scripts
# LOVABLE_API_KEY=...               # Lovable AI Gateway (call summaries, training)

# ---------------------------------------------------------------------------
# Telnyx — outbound calling + WebRTC
# ---------------------------------------------------------------------------
# Browser WebRTC credentials returned to the client by the telnyx-token edge fn
# VITE_TELNYX_LOGIN=...
# VITE_TELNYX_PASSWORD=...

# Server-side Telnyx config (edge functions only)
# TELNYX_API_KEY=KEY...
# TELNYX_WEBHOOK_SECRET=whsec_...
# TELNYX_OUTBOUND_VOICE_PROFILE_ID=...